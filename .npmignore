# Publish the CLI (bin/, src/) plus every objective folder at the repo root.
# Only exclude dev/CI cruft; objective folders are NOT listed so they ship.
.github/
.git/
*.log
*.tgz
.DS_Store
.env
node_modules/

# Local install artifacts and maintainer-only agents (gitignored; npm ignores
# .gitignore once .npmignore exists, so repeat them here).
/.claude/
/.cursor/
/.windsurf/

# Repo-only tests and generator
/test/
/scripts/

# Runtime validation fixtures are source-checkout only
/fixtures/
